# ==========================================================
# 環境変数テンプレート
# 使い方: このファイルを .env.local にコピーし、実際の値を設定してください。
#   PowerShell:  Copy-Item .env.example .env.local
# .env.local は .gitignore で除外されています。実際の値をこのファイルに書かないでください。
# ==========================================================

# --- Supabase（Project Settings > API） ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 取り込み CLI 専用（管理者 PC の .env.local のみ）。Vercel には設定しない。
# クライアントコードや NEXT_PUBLIC_ 変数で絶対に使用しないこと
SUPABASE_SERVICE_ROLE_KEY=

# --- 回答生成: Claude API ---
ANTHROPIC_API_KEY=
# 許可リスト: claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5（それ以外は起動時エラー）
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high（チャット用途は low 推奨。上げるほど費用・応答時間が増える）
ANTHROPIC_EFFORT=low
# 1 回答あたりの出力上限トークン（思考を含む。1024〜16000）
ANTHROPIC_MAX_TOKENS=8000
# 自動再試行回数（0〜2）とタイムアウト（ミリ秒）
ANTHROPIC_MAX_RETRIES=1
ANTHROPIC_TIMEOUT_MS=30000
# 拒否時に別モデルで自動再実行する（課金先モデルが変わるため既定は false）
ANTHROPIC_SERVER_FALLBACK=false

# --- Embedding: OpenAI Embeddings API ---
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# DB の vector(1536) 列と一致させるため固定（変更すると起動時エラー）
EMBEDDING_DIMENSIONS=1536
OPENAI_MAX_RETRIES=1

# --- 検索パラメータ ---
# コサイン類似度のしきい値（0〜1）。これ未満のチャンクは根拠として使わない
RAG_MATCH_THRESHOLD=0.3
# 取得するチャンク数（1〜20）
RAG_MATCH_COUNT=6

# --- 認可の補助設定 ---
# カンマ区切りの許可メールドメイン（完全一致）。未確定のためダミー値。
# ドメイン一致だけでは利用できず、app_users テーブルでの有効化が必須。
ALLOWED_EMAIL_DOMAINS=example.com

# --- 実 DB の検証用（任意・npm run verify:db）---
# 設定すると、このユーザーでログインして RLS・検索・PDF 取得を読み取り専用で確認する。
# 検証が終わったら値を消すこと。Vercel には絶対に設定しない（設定するとビルドが中止される）
VERIFY_USER_EMAIL=
VERIFY_USER_PASSWORD=
# T-1 用（npm run sectest -- verify）: app_users に登録していないテストユーザー
VERIFY_UNREGISTERED_EMAIL=
VERIFY_UNREGISTERED_PASSWORD=
